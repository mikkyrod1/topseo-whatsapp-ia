# Copia este archivo a .env (cp .env.example .env) y llena los valores.
# El .env se queda solo en tu computadora o en tu servidor: no lo subas a ningún lado ni lo compartas.

# Meta: token permanente del usuario del sistema (whatsapp_business_messaging y whatsapp_business_management)
META_ACCESS_TOKEN=
# Identificador del número de teléfono (Configuración de la API de tu app)
META_PHONE_NUMBER_ID=
# Identificador de la cuenta de mensajes, donde vive el número (Configuración de la API; comandos del paso i del README)
META_MESSAGING_ACCOUNT_ID=
# Clave secreta de la app (menú Configuración de la app > Básica): el servidor revisa con ella la firma de cada aviso
META_APP_SECRET=
# Contraseña que tú inventas para verificar el webhook; la misma va en el panel de Meta
META_VERIFY_TOKEN=
# PIN de 6 dígitos que tú eliges para la verificación en dos pasos del número (paso d)
META_REGISTER_PIN=
# Versión de la API de Meta; usa la que indique la guía oficial si cambia
META_GRAPH_VERSION=v23.0

# Anthropic (la IA que contesta)
ANTHROPIC_API_KEY=
# Modelo de Claude que vas a usar (consulta la lista de modelos en la documentación de Anthropic)
CLAUDE_MODEL=
